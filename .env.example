TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

REDIS_URL=redis://localhost:6379/0

POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=database_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Comma-separated Telegram admin IDs
ADMIN_TELEGRAM_IDS=your_admin_telegram_id_here

# --------------------------------------------------
# Bot transport mode
# --------------------------------------------------
# Use: polling or webhook
BOT_MODE=polling

# --------------------------------------------------
# Webhook settings
# --------------------------------------------------
# Public HTTPS URL Telegram should call.
# Example: https://bot.example.com/webhook/SECRET_PATH
PUBLIC_WEBHOOK_URL=

# Optional local path override. If empty, path is taken from PUBLIC_WEBHOOK_URL.
WEBHOOK_PATH=

# Local bind address and port for the webhook server
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8443

# Optional secret token for webhook validation.
# If empty, bot token is used as fallback.
WEBHOOK_SECRET_TOKEN=

# Optional TLS certificate/key if the bot itself terminates TLS.
# Leave empty if TLS is terminated by Nginx / Caddy / Traefik.
WEBHOOK_CERT_PATH=
WEBHOOK_KEY_PATH=

# Optional: discard old pending updates on startup
DROP_PENDING_UPDATES=false